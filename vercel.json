{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": [
        "videos/**",
        "logo.png"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/videos/:path*",
      "destination": "/api/videos/:path*"
    },
    {
      "source": "/logo.png",
      "destination": "/api/logo.png"
    }
  ]
}